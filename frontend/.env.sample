# ============================================================
# Krishi-AI Frontend — Environment Variables
# Copy this file to .env and fill in your actual values.
# ============================================================

# --- Backend (Node.js) ---
VITE_BACKEND_BASE_URL=https://agro-tech-ai-backend-teal.vercel.app/

# --- Krishi-AI Python API (FastAPI) ---
# Local dev: http://localhost:8000
# Production: your deployed FastAPI URL
VITE_CROP_API_URL=http://localhost:8000

# --- Feature API Endpoints (all served from VITE_CROP_API_URL) ---
# Crop Recommendation  → POST /api/croprecommendation/predict
# Crop Rotation        → POST /api/croprotation/recommend
# Rotation Plan        → POST /api/croprotationplan/generate
# Price Prediction     → GET  /api/priceprediction/overview
#                        POST /api/priceprediction/detail
# Crop Identification  → POST /api/cropidentification/identify

# --- Gradio Proxy (Crop Identification via Gradio Space) ---
VITE_GRADIO_PROXY_BASE=/gradio-api

# --- Maps ---
