# ============================================================
# Krishi-AI API — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# --- AI / LLM Keys ---
# OpenAI — used for crop insight, category prediction fallback
OPENAI_API_KEY=sk-your_openai_api_key_here

# Groq — used for chatbot and crop identification vision
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini — used for AI agronomic insights (optional fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- CORS ---
# Use * for development. In production, set your frontend domain:
# CORS_ORIGINS=https://your-frontend.vercel.app
CORS_ORIGINS=*
